<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xmlns="http://maven.apache.org/POM/4.0.0"
		 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>com.system24seven.ignition</groupId>
		<artifactId>hivemqtt</artifactId>
		<version>1.2.0-SNAPSHOT</version>
	</parent>

	<artifactId>hivemqtt-webui</artifactId>

	<properties>
		<maven.compiler.source>21</maven.compiler.source>
		<maven.compiler.target>21</maven.compiler.target>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<node.version>v18.0.0</node.version>
		<yarn.version>v1.22.18</yarn.version>
		<npm.version>8.5.5</npm.version>
		<frontend.plugin.version>1.15.1</frontend.plugin.version>
	</properties>

	<build>
		<plugins>
			<plugin>
				<groupId>com.github.eirslett</groupId>
				<artifactId>frontend-maven-plugin</artifactId>
				<version>${frontend.plugin.version}</version>

				<configuration>
					<nodeVersion>${node.version}</nodeVersion>
					<yarnVersion>${yarn.version}</yarnVersion>
					<!-- Where your package.json is located -->
					<workingDirectory>${project.basedir}</workingDirectory>
					<!-- Where Node/Yarn will be installed -->
					<installDirectory>${project.build.directory}</installDirectory>
				</configuration>

				<executions>
					<!-- Install Node and Yarn -->
					<execution>
						<id>install-node-and-yarn</id>
						<goals>
							<goal>install-node-and-yarn</goal>
						</goals>
						<phase>initialize</phase>
					</execution>

					<!-- Run yarn install -->
					<execution>
						<id>yarn-install</id>
						<goals>
							<goal>yarn</goal>
						</goals>
						<phase>initialize</phase>
						<configuration>
							<arguments>install --verbose</arguments>
						</configuration>
					</execution>

					<!-- Run yarn build-dev (NOT npm!) -->
					<execution>
						<id>yarn-build</id>
						<goals>
							<goal>yarn</goal>  <!-- CHANGED: Use yarn, not npm -->
						</goals>
						<phase>generate-resources</phase>
						<configuration>
							<arguments>run build-dev</arguments>
						</configuration>
					</execution>
				</executions>
			</plugin>

			<!-- Ensure JAR plugin includes resources -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-jar-plugin</artifactId>
				<version>3.3.0</version>
				<configuration>
					<archive>
						<addMavenDescriptor>false</addMavenDescriptor>
					</archive>
				</configuration>
			</plugin>

			<!-- Clean plugin -->
			<plugin>

				<artifactId>maven-clean-plugin</artifactId>
				<version>3.3.2</version>
				<configuration>
					<filesets>
						<fileset>
							<directory>${project.basedir}/node_modules</directory>
						</fileset>
						<fileset>
							<directory>${project.basedir}/build/dist</directory>
						</fileset>
					</filesets>
				</configuration>
			</plugin>
		</plugins>
		<!-- REPLACED build-helper-maven-plugin with standard resources -->
		<resources>
			<resource>
				<directory>${project.basedir}/build/generated-resources/mounted</directory>
				<targetPath>mounted</targetPath>
			</resource>
		</resources>
	</build>
</project>